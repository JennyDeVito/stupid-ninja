	"html.format.indentInnerHtml": true,
	"html.format.wrapLineLength": 100,
	"javascript.format.placeOpenBraceOnNewLineForControlBlocks": true,
	"javascript.format.placeOpenBraceOnNewLineForFunctions": true,
	"javascript.format.semicolons": "insert",
	"javascript.referencesCodeLens.enabled": true,
	"javascript.referencesCodeLens.showOnAllFunctions": true,
	"launch": {
		"compounds": [],
		"configurations": [],
		"inputs": [],
		"version": "0.2.0",
	},
	"less.format.spaceAroundSelectorSeparator": true,
	"less.lint.boxModel": "warning",
	"less.lint.duplicateProperties": "warning",
	// Configs do OminiPascal
	"omnipascal.createBuildScripts": true,
	"omnipascal.defaultDevelopmentEnvironment": "FreePascal",
	"omnipascal.usesListStyle": "oneItemPerLine",
	// Opções do Pascal Formatter (ptop)
	"pascal.format.indent": 4,
	"pascal.formatter.engine": "ptop",
	"pascal.formatter.engineParameters": "/home/jdevito/Pascal/ptop.cfg",
	// TODO: Editar ptop.cfg e reativar a extensão
	"pascal.formatter.enginePath": "/usr/bin/ptop",
	"prettier.bracketSameLine": true,
	"prettier.insertPragma": true,
